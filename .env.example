# WoodTek ERP — environment variables
# ------------------------------------------------------------------------
# Copy this file to `.env` on the server (it is git-ignored) and fill in the
# values. The factory PC already has a working `.env` — this file documents
# every variable the app understands so a fresh install never fails with a
# cryptic "DATABASE_URL is required".
# ------------------------------------------------------------------------

# --- Required -----------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/woodtek

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# Production REFUSES TO START without it (>= 16 chars). Changing it signs
# everyone out.
AUTH_SECRET=

# --- Session cookie -----------------------------------------------------

# "auto" (default) sends the Secure cookie flag only over HTTPS.
# The factory LAN runs plain HTTP → keep "false" there.
# Force "true" only behind an HTTPS reverse proxy.
AUTH_COOKIE_SECURE=auto

# --- Database pool tuning (optional) ------------------------------------
# Give up connecting after N ms (default 5000).
DB_CONNECT_TIMEOUT_MS=5000
# Max pooled connections (default 10).
DB_POOL_MAX=10

# --- Data directory (optional) ------------------------------------------
# Where the JSON overlay stores live (bom-status, dispatch-status, audit
# log, roles/menu config, delivery photo uploads, …). Default: ./data
# start-prod.cjs sets this to <project>/data automatically.
# WOODTEK_DATA_DIR=

# --- Backups (dbtools / nightly task, optional) -------------------------
# pg_dump output folder (default: <data dir parent>/db-backups).
# WOODTEK_DB_BACKUP_DIR=
# How many db dumps to keep (default 14).
# WOODTEK_DB_BACKUP_KEEP=14
# FULL system backup folder (default C:\WoodTekBackups\full on Windows).
# WOODTEK_FULL_BACKUP_DIR=
# Folder containing pg_dump/psql binaries (default: rely on PATH).
# WOODTEK_PG_BIN=

# --- Business tuning (optional) ------------------------------------------
# A quotation older than this many days counts as "stale" in the digest
# (default 14).
# WOODTEK_QUOTE_STALE_DAYS=14

# --- Demo mode (development only) ----------------------------------------
# Enables the quick-login demo buttons on the sign-in screen.
# WOODTEK_DEMO=1
# NEXT_PUBLIC_WOODTEK_DEMO=1

# --- Set automatically (do not edit) -------------------------------------
# PORT / HOSTNAME          — set by start-prod.cjs for the standalone server
# NEXT_PUBLIC_WOODTEK_BUILD — git SHA injected by scripts/build-prod.cjs
